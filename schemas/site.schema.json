{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/site.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "configuration",
    "resumes",
    "menu",
    "images",
    "projectTypes",
    "participationModes",
    "technologies",
    "institutions",
    "projects",
    "skills",
    "studies",
    "jobs"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headerName",
        "fullName",
        "jobSearchActive",
        "website",
        "email",
        "phone",
        "linkedin",
        "location",
        "socials"
      ],
      "properties": {
        "headerName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "fullName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "jobSearchActive": { "type": "boolean" },
        "website": { "$ref": "#/$defs/link" },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "address"],
          "properties": {
            "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "address": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          }
        },
        "phone": { "$ref": "#/$defs/link" },
        "linkedin": { "$ref": "#/$defs/link" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href"],
          "properties": {
            "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          }
        },
        "socials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order", "href"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/domainId" },
              "order": { "$ref": "common.schema.json#/$defs/order" },
              "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formAction", "socialImage"],
      "properties": {
        "formAction": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "socialImage": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "resumes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "$ref": "#/$defs/resume" },
        "es": { "$ref": "#/$defs/resume" }
      }
    },
    "menu": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/orderedReference" }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProjectImageId", "commonImages", "technologyImages", "institutionImages", "projectImages"],
      "properties": {
        "defaultProjectImageId": { "$ref": "common.schema.json#/$defs/domainId" },
        "commonImages": { "$ref": "#/$defs/imageMap" },
        "technologyImages": { "$ref": "#/$defs/imageMap" },
        "institutionImages": { "$ref": "#/$defs/imageMap" },
        "projectImages": { "$ref": "#/$defs/imageMap" }
      }
    },
    "projectTypes": { "$ref": "#/$defs/idCatalog" },
    "participationModes": { "$ref": "#/$defs/idCatalog" },
    "technologies": { "$ref": "#/$defs/resourceCatalog" },
    "institutions": { "$ref": "#/$defs/resourceCatalog" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "typeIds",
          "participationModeId",
          "technologyIds",
          "sourceCode",
          "liveDemo",
          "videoUrl",
          "mockupId",
          "shownInPortfolio",
          "shownInCv"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/domainId" },
          "order": { "$ref": "common.schema.json#/$defs/order" },
          "typeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/domainId" }
          },
          "participationModeId": { "$ref": "common.schema.json#/$defs/domainId" },
          "technologyIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/domainId" }
          },
          "sourceCode": { "$ref": "common.schema.json#/$defs/nullableString" },
          "liveDemo": { "$ref": "common.schema.json#/$defs/nullableString" },
          "websiteUrl": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "videoUrl": { "$ref": "common.schema.json#/$defs/nullableString" },
          "mockupId": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/domainId" },
              { "type": "null" }
            ]
          },
          "shownInPortfolio": { "type": "boolean" },
          "shownInCv": { "type": "boolean" }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cvGroupId", "groups"],
      "properties": {
        "cvGroupId": { "$ref": "common.schema.json#/$defs/domainId" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order"],
            "oneOf": [
              { "required": ["technologyIds"] },
              { "required": ["categories"] }
            ],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/domainId" },
              "order": { "$ref": "common.schema.json#/$defs/order" },
              "technologyIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "common.schema.json#/$defs/domainId" }
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "order", "technologyIds"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/domainId" },
                    "order": { "$ref": "common.schema.json#/$defs/order" },
                    "technologyIds": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "$ref": "common.schema.json#/$defs/domainId" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "institutionId", "studyPlan", "certificate", "type", "shownInCv"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/domainId" },
          "order": { "$ref": "common.schema.json#/$defs/order" },
          "institutionId": { "$ref": "common.schema.json#/$defs/domainId" },
          "studyPlan": { "$ref": "common.schema.json#/$defs/nullableString" },
          "certificate": { "$ref": "common.schema.json#/$defs/nullableString" },
          "graduationDate": { "$ref": "common.schema.json#/$defs/date" },
          "type": { "enum": ["career", "course", "language"] },
          "shownInCv": { "type": "boolean" }
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "startDate", "endDate"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/domainId" },
          "order": { "$ref": "common.schema.json#/$defs/order" },
          "startDate": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/yearMonth" },
              { "$ref": "common.schema.json#/$defs/date" }
            ]
          },
          "endDate": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/yearMonth" },
              { "$ref": "common.schema.json#/$defs/date" },
              { "type": "null" }
            ]
          },
          "technologyIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/domainId" }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "label"],
      "properties": {
        "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "download"],
      "properties": {
        "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "download": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "orderedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "href"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/domainId" },
        "order": { "$ref": "common.schema.json#/$defs/order" },
        "href": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "imageMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/domainId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src"],
        "properties": {
          "src": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "resourceCatalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/domainId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imageId"],
        "properties": {
          "imageId": { "$ref": "common.schema.json#/$defs/domainId" }
        }
      }
    },
    "idCatalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/domainId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
