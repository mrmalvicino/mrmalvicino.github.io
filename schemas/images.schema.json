{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/images.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "common_images",
    "technologies_images",
    "institutions_images",
    "projects_images"
  ],
  "properties": {
    "common_images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/image"
      }
    },
    "technologies_images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/image"
      }
    },
    "institutions_images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/image"
      }
    },
    "projects_images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/image"
      }
    }
  }
}
