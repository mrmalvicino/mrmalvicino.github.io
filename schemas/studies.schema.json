{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/studies.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "studies"
  ],
  "properties": {
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "institution_id",
          "institution_name",
          "title",
          "study_plan",
          "certificate",
          "type",
          "shown_in_cv"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/domainId"
          },
          "order": {
            "$ref": "common.schema.json#/$defs/order"
          },
          "institution_id": {
            "$ref": "common.schema.json#/$defs/domId"
          },
          "institution_name": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "study_plan": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "certificate": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "type": {
            "enum": [
              "career",
              "course",
              "language"
            ]
          },
          "shown_in_cv": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
