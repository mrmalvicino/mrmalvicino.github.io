{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/buttons.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_page_buttons"
  ],
  "properties": {
    "index_page_buttons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_items",
        "button_items"
      ],
      "properties": {
        "a_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "href",
              "download"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/domId"
              },
              "href": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "download": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "button_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text_content"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/domId"
              },
              "text_content": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    }
  }
}
