{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/skills.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "banner_items",
    "stacks"
  ],
  "properties": {
    "banner_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/domId"
      }
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/domId"
          },
          "order": {
            "$ref": "common.schema.json#/$defs/order"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      }
    }
  }
}
