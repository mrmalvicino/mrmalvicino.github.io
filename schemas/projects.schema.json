{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/projects.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projects"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "description",
          "technologies_ids",
          "source_code",
          "live_demo",
          "video_url",
          "mockup_id",
          "shown_in_portfolio",
          "shown_in_cv"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/domainId"
          },
          "order": {
            "$ref": "common.schema.json#/$defs/order"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "technologies_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/domId"
            }
          },
          "source_code": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "live_demo": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "video_url": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "mockup_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/domId"
              },
              {
                "type": "null"
              }
            ]
          },
          "shown_in_portfolio": {
            "type": "boolean"
          },
          "shown_in_cv": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
