{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/locale.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "professionalProfiles",
    "seo",
    "navigation",
    "images",
    "technologies",
    "projectTypes",
    "participationModes",
    "institutions",
    "menu",
    "projects",
    "skills",
    "studies",
    "jobs",
    "labels",
    "buttons",
    "placeholders",
    "messages",
    "accessibility",
    "socials"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["footerLocation", "cvLocation"],
      "properties": {
        "footerLocation": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "cvLocation": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "professionalProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "jobSearch"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "jobSearch": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "projects", "cv"],
      "properties": {
        "index": { "$ref": "#/$defs/seoPage" },
        "projects": { "$ref": "#/$defs/seoPage" },
        "cv": { "$ref": "#/$defs/seoPage" }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "portfolio", "projects", "cv"],
      "properties": {
        "main": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "portfolio": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "projects": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "cv": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "images": { "$ref": "#/$defs/imageTranslations" },
    "technologies": { "$ref": "#/$defs/stringTranslations" },
    "projectTypes": { "$ref": "#/$defs/stringTranslations" },
    "participationModes": { "$ref": "#/$defs/stringTranslations" },
    "institutions": { "$ref": "#/$defs/stringTranslations" },
    "menu": { "$ref": "#/$defs/stringTranslations" },
    "projects": { "$ref": "#/$defs/entityTranslations" },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "groups", "categories", "items"],
      "properties": {
        "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "groups": { "$ref": "#/$defs/stringTranslations" },
        "categories": { "$ref": "#/$defs/stringTranslations" },
        "items": { "$ref": "#/$defs/stringTranslations" }
      }
    },
    "studies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organization", "position", "description"],
        "properties": {
          "organization": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "position": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "index", "projects", "cv"],
      "properties": {
        "common": { "$ref": "#/$defs/stringTranslations" },
        "index": { "$ref": "#/$defs/stringTranslations" },
        "projects": { "$ref": "#/$defs/stringTranslations" },
        "cv": { "$ref": "#/$defs/stringTranslations" }
      }
    },
    "buttons": { "$ref": "#/$defs/stringTranslations" },
    "placeholders": { "$ref": "#/$defs/stringTranslations" },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emailCopied",
        "emailCopyFailed",
        "formSubmitting",
        "formSuccess",
        "formServerError",
        "formNetworkError",
        "noProjects"
      ],
      "properties": {
        "emailCopied": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "emailCopyFailed": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "formSubmitting": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "formSuccess": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "formServerError": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "formNetworkError": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "noProjects": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videoPlayer",
        "newTab",
        "skipToContent",
        "primaryNavigation",
        "languageNavigation",
        "openMenu",
        "closeMenu",
        "institution",
        "study",
        "documents",
        "studyPlan",
        "certificateLink",
        "requiredFields"
      ],
      "properties": {
        "videoPlayer": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "newTab": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "skipToContent": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "primaryNavigation": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "languageNavigation": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "openMenu": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "closeMenu": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "institution": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "study": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "documents": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "studyPlan": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "certificateLink": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "requiredFields": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "socials": { "$ref": "#/$defs/stringTranslations" }
  },
  "$defs": {
    "seoPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "stringTranslations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "entityTranslations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "imageTranslations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alt"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "alt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
