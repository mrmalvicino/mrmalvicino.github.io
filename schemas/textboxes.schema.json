{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/textboxes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_page_textboxes"
  ],
  "properties": {
    "index_page_textboxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "placeholder"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/domId"
          },
          "placeholder": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
