{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mrmalvicino.com/schemas/menu.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "menu_items"
  ],
  "properties": {
    "menu_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "label",
          "href"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/domainId"
          },
          "order": {
            "$ref": "common.schema.json#/$defs/order"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "href": {
            "type": "string",
            "pattern": "^#[A-Za-z][A-Za-z0-9]*$"
          }
        }
      }
    }
  }
}
