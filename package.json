{
  "name": "mrmalvicino.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio and resume static site",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test test/*.test.mjs",
    "pretest:browser": "playwright install chromium",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "build": "node tools/build.mjs",
    "build:pdf": "node tools/generate-pdf.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fontsource-variable/open-sans": "^5.2.7",
    "@fontsource/jost": "^5.2.8",
    "@playwright/test": "1.56.1",
    "ajv": "^8.20.0",
    "bootstrap-icons": "^1.13.1",
    "pdfjs-dist": "5.4.394",
    "sharp": "^0.35.5"
  }
}
