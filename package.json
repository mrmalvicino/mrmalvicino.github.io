{
  "name": "mrmalvicino.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio and resume static site",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test test/*.test.mjs",
    "pretest:browser": "playwright install chromium",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "build": "npm run validate && node tools/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "ajv": "^8.20.0"
  }
}
